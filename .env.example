# ============================================================
# MYSQL / MariaDB
# ============================================================
MYSQL_ENGINE=mariadb
MYSQL_VERSION=10.6
MYSQL_ROOT_PASSWORD=change_me_strong_password   # REQUIRED
MYSQL_DATABASE=whaticket
MYSQL_PORT=3306
TZ=America/Bogota

# ============================================================
# BACKEND
# ============================================================
BACKEND_PORT=8080
BACKEND_SERVER_NAME=                            # e.g. api.mydomain.com (leave empty for localhost)
BACKEND_URL=http://localhost                    # Use https:// in production
PROXY_PORT=8080                                 # 443 when behind HTTPS reverse proxy

# REQUIRED — generate with: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=

# WhatsApp provider: wwebjs (Puppeteer) or whaileys (Baileys)
WHATSAPP_PROVIDER=wwebjs

# Log level: silent | fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ============================================================
# FRONTEND
# ============================================================
FRONTEND_PORT=3000
FRONTEND_SSL_PORT=3001
FRONTEND_SERVER_NAME=                           # e.g. app.mydomain.com (leave empty for localhost)
FRONTEND_URL=http://localhost:3000              # Use https:// in production

# ============================================================
# AI SUPPORT CHAT (optional — leave empty to disable)
# ============================================================
ANTHROPIC_API_KEY=                              # Get from https://console.anthropic.com

# ============================================================
# PING CHECK — Zabbix (preferred) or Splynx netcheck.php (fallback)
# ============================================================
# Option A — Zabbix API (recommended: reads cached monitoring data, ~100ms)
# The system tries Zabbix first; if the IP is not found in Zabbix it falls
# back to netcheck.php automatically.
#
#   ZABBIX_API_URL   — JSON-RPC endpoint, e.g. https://zabbix.domain.com/api_jsonrpc.php
#   ZABBIX_API_TOKEN — API token (Zabbix 5.4+). Generate in:
#                      Administration → API tokens → Create API token
#   Or use user / password instead of token:
#   ZABBIX_API_USER / ZABBIX_API_PASSWORD — a read-only Zabbix user
#
ZABBIX_API_URL=
ZABBIX_API_TOKEN=                               # preferred — or use USER+PASSWORD below
ZABBIX_API_USER=
ZABBIX_API_PASSWORD=

# Option B — Splynx netcheck.php (live ping, ~2–4 s; leave empty if using Zabbix)
# See README § Splynx Integration → Real-time ping check for setup instructions.
SPLYNX_PING_TOKEN=                              # Must match the token in netcheck.php on your Splynx server

# ============================================================
# EMAIL / SMTP (for password recovery — leave empty to disable)
# ============================================================
SMTP_HOST=                                      # e.g. smtp.gmail.com
SMTP_PORT=587                                   # 587 (TLS) or 465 (SSL)
SMTP_USER=                                      # your email address
SMTP_PASS=                                      # app password (Gmail) or SMTP password
SMTP_FROM=                                      # display name + address, e.g: ExaTicket <noreply@example.com>

# ============================================================
# PHPMYADMIN (optional)
# ============================================================
PMA_PORT=9000

# ============================================================
# BROWSERLESS (optional — use instead of local Chrome)
# ============================================================
MAX_CONCURRENT_SESSIONS=1
